import re
from typing import Tuple

def clean_cnpj(raw: str) -> str:
    return re.sub(r"\D", "", str(raw).strip())

def validate_cnpj(cnpj: str) -> bool:
    c = clean_cnpj(cnpj)
    if len(c) != 14 or len(set(c)) == 1:
        return False
    def calc(c, n):
        weights = list(range(n, 1, -1)) + list(range(9, 1, -1))
        s = sum(int(c[i]) * weights[i] for i in range(n - 1))
        r = 11 - (s % 11)
        return 0 if r >= 10 else r
    return calc(c, 13) == int(c[12]) and calc(c, 14) == int(c[13])

def format_cnpj(cnpj: str) -> str:
    c = clean_cnpj(cnpj)
    if len(c) == 14:
        return f"{c[:2]}.{c[2:5]}.{c[5:8]}/{c[8:12]}-{c[12:]}"
    return cnpj

def parse_upload(df) -> Tuple[list, list, list]:
    """Returns (valid, duplicates, invalid) as lists of dicts."""
    # Detect CNPJ column
    col = None
    for c in df.columns:
        sample = df[c].dropna().astype(str).head(10)
        hits = sum(1 for v in sample if len(clean_cnpj(v)) >= 11)
        if hits >= 3:
            col = c
            break
    if col is None:
        col = df.columns[0]

    seen = set()
    valid, dups, invalid = [], [], []

    for idx, row in df.iterrows():
        raw = str(row[col])
        c = clean_cnpj(raw)
        extra = {k: v for k, v in row.items() if k != col}
        entry = {"raw": raw, "cnpj": format_cnpj(c), "clean": c,
                 "row": idx + 2, "extra": extra}
        if not validate_cnpj(c):
            entry["reason"] = "Formato ou dígito verificador inválido"
            invalid.append(entry)
        elif c in seen:
            entry["reason"] = "Duplicado"
            dups.append(entry)
        else:
            seen.add(c)
            valid.append(entry)

    return valid, dups, invalid
